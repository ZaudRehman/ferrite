{
  "app-id": "com.ferrite.Browser",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "ferrite",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--filesystem=home:ro",
    "--talk-name=org.freedesktop.portal.FileChooser",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "ferrite",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --locked --release && install -Dm755 target/release/ferrite /app/bin/ferrite",
        "install -Dm644 crates/ferrite-shell/assets/ferrite.desktop /app/share/applications/com.ferrite.Browser.desktop",
        "install -Dm644 LICENSES/LICENSE-MIT /app/share/licenses/com.ferrite.Browser/LICENSE"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/anomalyco/opencode.git",
          "tag": "v0.1.0"
        }
      ]
    }
  ]
}
